{
    "name": "wmffl/draft-api",
    "description": "JSON REST API for the WMFFL draft tool (re-platform of src/ — see docs/modernization-spec.md)",
    "type": "project",
    "require": {
        "php": ">=8.3"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "require-dev": {
        "phpunit/phpunit": "^11"
    }
}
